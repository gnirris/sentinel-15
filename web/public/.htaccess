# Namecheap shared hosting (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html

# Compress the 5 MB model file and the app on the wire (~1.5 MB)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|gz)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Model files are gzipped at export time; serve them as plain bytes, don't re-encode.
<FilesMatch "\.gz$">
  ForceType application/octet-stream
  <IfModule mod_mime.c>
    RemoveEncoding .gz
  </IfModule>
  <IfModule mod_env.c>
    SetEnv no-gzip 1
  </IfModule>
</FilesMatch>
